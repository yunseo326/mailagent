# NAVER WORKS 계정과 외부 앱 비밀번호
NAVER_WORKS_EMAIL=user@example.com
NAVER_WORKS_APP_PASSWORD=
NAVER_WORKS_IMAP_HOST=imap.worksmobile.com
NAVER_WORKS_IMAP_PORT=993

# 개인 네이버 메일 (선택 사항)
NAVER_MAIL_EMAIL=user@example.com
NAVER_MAIL_APP_PASSWORD=
NAVER_MAIL_IMAP_HOST=imap.naver.com
NAVER_MAIL_IMAP_PORT=993
NAVER_MAIL_SMTP_HOST=smtp.naver.com
NAVER_MAIL_SMTP_PORT=587

# 요약을 받을 Gmail 주소 (Gmail 비밀번호는 필요하지 않음)
SUMMARY_RECIPIENT=user@example.com

# 생성한 요약 메일을 받을 Gmail 주소 (Gmail 비밀번호는 필요 없음)
SUMMARY_RECIPIENT=user@example.com
